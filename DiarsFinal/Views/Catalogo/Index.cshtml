@model List<DiarsFinal.Models.Producto>

@{
    ViewData["Title"] = "Catálogo";

    string heroUrl = "https://images.unsplash.com/photo-1578985545062-69928b1d9587";

    string[] imagenes = new[]
    {
        "https://images.unsplash.com/photo-1578985545062-69928b1d9587",
        "https://images.unsplash.com/photo-1606890737304-57a1ca8a5b62",
        "https://images.unsplash.com/photo-1464349095431-e9a21285b5f3",
        "https://images.unsplash.com/photo-1486427944299-d1955d23e34d",
        "https://images.unsplash.com/photo-1519869325930-281384150729",
        "https://images.unsplash.com/photo-1551024506-0bccd828d307"
    };
}

<style>
    :root {
        --rosa-1: #FFF7FA;
        --rosa-2: #FCE7EF;
        --rosa-3: #F4C2D3;
        --rosa-4: #C96B8A;
        --rosa-5: #8F3158;
        --blanco: #FFFFFF;
        --crema: #FFFDFC;
        --negro: #1F1B1C;
        --marron: #5C4A46;
        --marron-claro: #715E59;
        --marron-muy-claro: #B9A6A0;
        --borde: rgba(92, 74, 70, .20);
        --borde-rosa: rgba(143, 49, 88, .28);
        --sombra: 0 22px 50px rgba(31, 27, 28, .10);
        --sombra-suave: 0 10px 24px rgba(31, 27, 28, .07);
        --foco-accesible: #0072B2;
    }

    body {
        background: radial-gradient(circle at 12% 16%, rgba(244, 194, 211, .45), transparent 30%), radial-gradient(circle at 88% 78%, rgba(185, 166, 160, .18), transparent 34%), linear-gradient(135deg, #FFF8FA 0%, #FFFFFF 48%, #FDEFF4 100%);
        color: var(--negro);
    }

    .catalog-page {
        padding: 30px 0 58px;
        min-height: 88vh;
    }

    .catalog-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        background: linear-gradient(135deg, #FFFDFC 0%, #FFF8FA 58%, #FCE7EF 100%);
        box-shadow: var(--sombra);
        border: 1px solid rgba(255,255,255,.92);
        margin-bottom: 34px;
    }

        .catalog-hero::before {
            content: "";
            position: absolute;
            width: 270px;
            height: 270px;
            border-radius: 50%;
            background: linear-gradient(135deg, #F4C2D3, #FCE7EF);
            right: -105px;
            top: -105px;
            opacity: .75;
        }

        .catalog-hero::after {
            content: "Vienna";
            position: absolute;
            right: 34px;
            bottom: 6px;
            font-family: 'Great Vibes', cursive;
            font-size: 3.45rem;
            color: rgba(92, 74, 70, .10);
            transform: rotate(-5deg);
        }

    .catalog-hero-inner {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.18fr .82fr;
        min-height: 245px;
    }

    .catalog-hero-content {
        padding: 34px 42px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .catalog-kicker {
        color: var(--marron-claro);
        font-size: .64rem;
        font-weight: 900;
        letter-spacing: 2.2px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .catalog-title {
        font-family: 'Cormorant Garamond', serif;
        color: var(--negro);
        font-size: clamp(2rem, 3.2vw, 3.15rem);
        font-weight: 700;
        line-height: .96;
        margin-bottom: 10px;
    }

        .catalog-title span {
            color: var(--rosa-5);
            font-style: italic;
        }

    .catalog-text {
        max-width: 500px;
        color: var(--marron);
        line-height: 1.5;
        font-size: .88rem;
        margin-bottom: 18px;
    }

    .hero-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-catalog-primary,
    .btn-catalog-light {
        min-height: 40px;
        padding: 0 18px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        font-weight: 900;
        font-size: .82rem;
        transition: .25s ease;
    }

    .btn-catalog-primary {
        background: linear-gradient(135deg, var(--negro), #3B3133);
        color: white;
        box-shadow: 0 12px 24px rgba(31, 27, 28, .16);
    }

        .btn-catalog-primary:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 18px 34px rgba(31, 27, 28, .22);
        }

    .btn-catalog-light {
        background: rgba(255,255,255,.76);
        color: var(--marron);
        border: 1px solid rgba(143,49,88,.24);
    }

        .btn-catalog-light:hover {
            color: var(--negro);
            transform: translateY(-2px);
            box-shadow: var(--sombra-suave);
        }

    .catalog-hero-photo {
        position: relative;
        height: 245px;
        max-height: 245px;
        background: #F7DCE6;
        overflow: hidden;
    }

        .catalog-hero-photo img {
            width: 100%;
            height: 100%;
            max-height: 245px;
            object-fit: cover;
            object-position: center;
            display: block;
            filter: saturate(.98) contrast(.98);
        }

        .catalog-hero-photo::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(255,248,250,.28), transparent 40%), linear-gradient(180deg, transparent 55%, rgba(31,27,28,.24));
            z-index: 1;
        }

    .photo-badge {
        position: absolute;
        z-index: 2;
        left: 20px;
        bottom: 20px;
        padding: 10px 14px;
        border-radius: 18px;
        background: rgba(255,255,255,.76);
        border: 1px solid rgba(255,255,255,.88);
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 22px rgba(31,27,28,.10);
    }

        .photo-badge span {
            display: block;
            color: var(--marron-claro);
            font-size: .58rem;
            font-weight: 900;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 3px;
        }

        .photo-badge strong {
            font-family: 'Cormorant Garamond', serif;
            color: var(--negro);
            font-size: 1.18rem;
            font-weight: 700;
        }

    .catalog-header {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 22px;
    }

    .section-kicker {
        color: var(--marron-claro);
        font-size: .64rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 2.2px;
        margin-bottom: 7px;
    }

    .section-title {
        font-family: 'Cormorant Garamond', serif;
        color: var(--negro);
        font-size: clamp(1.9rem, 3vw, 2.65rem);
        font-weight: 700;
        line-height: 1;
        margin: 0;
    }

    .catalog-count {
        color: var(--marron);
        font-weight: 900;
        background: rgba(255,255,255,.78);
        border: 1px solid var(--borde-rosa);
        border-radius: 999px;
        padding: 9px 14px;
        font-size: .82rem;
        white-space: nowrap;
    }

    .product-grid {
        row-gap: 18px;
    }

    .product-card {
        height: 100%;
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(255,255,255,.92);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--sombra-suave);
        transition: .28s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 34px rgba(39, 33, 33, .10);
            border-color: rgba(143, 49, 88, .34);
        }

    .product-photo {
        position: relative;
        height: 125px;
        max-height: 125px;
        overflow: hidden;
        background: var(--rosa-2);
    }

        .product-photo img {
            width: 100%;
            height: 125px;
            max-height: 125px;
            object-fit: cover;
            object-position: center;
            display: block;
            transition: .55s ease;
        }

    .product-card:hover .product-photo img {
        transform: scale(1.05);
    }

    .product-photo::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 52%, rgba(31,27,28,.20));
    }

    .product-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        z-index: 2;
        padding: 5px 9px;
        border-radius: 999px;
        background: rgba(255,255,255,.84);
        border: 1px solid rgba(255,255,255,.88);
        backdrop-filter: blur(10px);
        color: var(--marron);
        font-size: .58rem;
        font-weight: 900;
        letter-spacing: .4px;
        max-width: calc(100% - 16px);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .product-body {
        padding: 14px;
    }

    .product-name {
        font-family: 'Cormorant Garamond', serif;
        color: var(--negro);
        font-size: 1.22rem;
        font-weight: 700;
        line-height: 1.05;
        margin-bottom: 5px;
    }

    .product-description {
        color: var(--marron);
        line-height: 1.32;
        min-height: 34px;
        margin-bottom: 10px;
        font-size: .74rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding-top: 10px;
        border-top: 1px solid rgba(92,74,70,.18);
        margin-bottom: 10px;
    }

    .price-label {
        color: var(--marron-claro);
        font-size: .56rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 900;
        margin-bottom: 2px;
    }

    .product-price {
        font-family: 'Cormorant Garamond', serif;
        color: var(--rosa-5);
        font-size: 1.38rem;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
    }

        .product-price small {
            color: var(--marron);
            font-family: 'DM Sans', sans-serif;
            font-size: .66rem;
            font-weight: 900;
            margin-right: 2px;
        }

    .price-star {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--rosa-1);
        border: 1px solid var(--borde-rosa);
        color: var(--rosa-5);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        flex: 0 0 26px;
    }

    .quantity-row {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 7px;
        align-items: end;
    }

    .quantity-control label {
        color: var(--marron);
        font-size: .62rem;
        font-weight: 900;
        margin-bottom: 4px;
    }

    .quantity-control input {
        width: 100%;
        height: 32px;
        border-radius: 11px;
        border: 1px solid var(--borde-rosa);
        background: #FFFFFF;
        color: var(--negro);
        font-weight: 900;
        text-align: center;
        outline: none;
        font-size: .78rem;
        transition: .25s ease;
    }

        .quantity-control input:focus {
            border-color: var(--rosa-5);
            box-shadow: 0 0 0 .16rem rgba(143,49,88,.18);
        }

    .btn-add {
        height: 32px;
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--negro), #3B3133);
        color: white;
        font-weight: 900;
        font-size: .72rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: .25s ease;
        width: 100%;
    }

        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(31,27,28,.18);
        }

    .catalog-footer {
        margin-top: 32px;
        display: flex;
        justify-content: center;
    }

    .btn-view-order {
        min-height: 44px;
        padding: 0 24px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--rosa-5), #79334F);
        color: white;
        text-decoration: none;
        font-weight: 900;
        font-size: .86rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 14px 28px rgba(143,49,88,.26);
        transition: .25s ease;
    }

        .btn-view-order:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 20px 38px rgba(143,49,88,.34);
        }

    .empty-catalog {
        background: rgba(255,255,255,.80);
        border: 1px solid rgba(255,255,255,.90);
        border-radius: 26px;
        padding: 42px 22px;
        text-align: center;
        box-shadow: var(--sombra-suave);
        color: var(--marron);
    }

        .empty-catalog i {
            font-size: 2.2rem;
            color: var(--rosa-5);
            margin-bottom: 12px;
        }

        .empty-catalog h3 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--negro);
            font-size: 1.85rem;
            font-weight: 700;
        }


    /* Accesibilidad: no altera la distribución ni el diseño visual base */
    a:focus-visible,
    button:focus-visible,
    input:focus-visible {
        outline: 3px solid var(--foco-accesible);
        outline-offset: 3px;
    }

    .btn-catalog-primary:focus-visible,
    .btn-catalog-light:focus-visible,
    .btn-add:focus-visible,
    .btn-view-order:focus-visible {
        box-shadow: 0 0 0 4px rgba(0, 114, 178, .22);
    }

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: .01ms !important;
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
        }
    }

    @@media (max-width: 991px) {
        .catalog-hero-inner {
            grid-template-columns: 1fr;
        }

        .catalog-hero-photo {
            height: 210px;
            max-height: 210px;
        }

            .catalog-hero-photo img {
                height: 210px;
                max-height: 210px;
            }

        .catalog-hero-content {
            padding: 34px 30px;
        }

        .catalog-header {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 576px) {
        .catalog-page {
            padding: 26px 0 54px;
        }

        .catalog-hero,
        .product-card {
            border-radius: 22px;
        }

        .catalog-title {
            font-size: 2.1rem;
        }

        .catalog-hero-content {
            padding: 30px 20px;
        }

        .hero-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-catalog-primary,
        .btn-catalog-light,
        .btn-view-order {
            width: 100%;
        }

        .product-photo,
        .product-photo img {
            height: 150px;
            max-height: 150px;
        }

        .quantity-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="catalog-page">
    <div class="container">

        <section class="catalog-hero">
            <div class="catalog-hero-inner">

                <div class="catalog-hero-content">
                    <div class="catalog-kicker">
                        Catálogo artesanal
                    </div>

                    <h1 class="catalog-title">
                        Dulces finos para <span>celebrar bonito</span>
                    </h1>

                    <p class="catalog-text">
                        Explora tortas, cupcakes y postres preparados con una estética delicada,
                        sabores memorables y acabado premium.
                    </p>

                    <div class="hero-actions">
                        <a href="#productos" class="btn-catalog-primary">
                            Ver productos
                            <i class="bi bi-arrow-down"></i>
                        </a>

                        <a asp-controller="Pedido"
                           asp-action="Index"
                           class="btn-catalog-light">
                            Ver pedido
                            <i class="bi bi-bag-heart"></i>
                        </a>
                    </div>
                </div>

                <div class="catalog-hero-photo">
                    <img src="@heroUrl"
                         alt="Selección de postres de Vienna Bake House" />

                    <div class="photo-badge">
                        <span>Vienna selection</span>
                        <strong>Bake House</strong>
                    </div>
                </div>

            </div>
        </section>

        <section id="productos">

            <div class="catalog-header">
                <div>
                    <div class="section-kicker">
                        Selección disponible
                    </div>

                    <h2 class="section-title">
                        Nuestro catálogo
                    </h2>
                </div>

                <div class="catalog-count">
                    @(Model?.Count ?? 0) producto(s)
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="row product-grid">

                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];

                        var imagen = !string.IsNullOrWhiteSpace(item.RutaImagen)
                        ? item.RutaImagen
                        : imagenes[i % imagenes.Length];

                        if (!imagen.StartsWith("http") && !imagen.StartsWith("/") && !imagen.StartsWith("~/"))
                        {
                            imagen = "/" + imagen;
                        }

                        if (imagen.StartsWith("~/"))
                        {
                            imagen = Url.Content(imagen);
                        }

                    <div class="col-6 col-md-4 col-xl-3">

                        <div class="product-card">

                            <div class="product-photo">
                                <img src="@imagen"
                                     alt="@item.Nombre" />

                                <div class="product-badge">
                                    @(item.IdCategoriaNavigation?.Nombre ?? "Vienna")
                                </div>
                            </div>

                            <div class="product-body">

                                <h3 class="product-name">
                                    @item.Nombre
                                </h3>

                                <p class="product-description">
                                    @(string.IsNullOrWhiteSpace(item.Descripcion)
                                                                    ? "Producto artesanal de Vienna Bake House."
                                                                    : item.Descripcion)
                            </p>

                                    <div class="product-price-row">
                                        <div>
                                            <div class="price-label">
                                                Precio
                                            </div>

                                            <div class="product-price">
                                                <small>S/.</small>@String.Format("{0:N2}", item.Precio)
                                            </div>
                                        </div>

                                        <span class="price-star">
                                            <i class="bi bi-stars"></i>
                                        </span>
                                    </div>

                                    <form asp-controller="Catalogo"
                                          asp-action="AgregarCarrito"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="idProducto"
                                               value="@item.IdProducto" />

                                        <div class="quantity-row">

                                            <div class="quantity-control">
                                                <label for="cantidad-@item.IdProducto">
                                                    Cantidad
                                                </label>

                                                <input type="number"
                                                       id="cantidad-@item.IdProducto"
                                                       name="cantidad"
                                                       aria-label="Cantidad de @item.Nombre"
                                                       value="1"
                                                       min="1" />
                                            </div>

                                            <button type="submit"
                                                    class="btn-add"
                                                    aria-label="Agregar @item.Nombre al pedido">
                                                Agregar
                                                <i class="bi bi-bag-plus"></i>
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>
                                }

                </div>
            }
            else
            {
                <div class="empty-catalog">
                    <i class="bi bi-search-heart"></i>

                    <h3>
                        No hay productos disponibles
                    </h3>

                    <p>
                        Aún no se han registrado productos en el catálogo.
                    </p>
                </div>
            }

            <div class="catalog-footer">
                <a asp-controller="Pedido"
                   asp-action="Index"
                   class="btn-view-order">
                    Ver pedido
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </section>

    </div>
</div>